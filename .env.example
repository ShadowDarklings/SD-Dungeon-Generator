# Course 506 Week 5 Skeleton — environment configuration
#
# Copy this file to .env (which is gitignored) and fill in your values.
#   cp .env.example .env
#   nano .env
#
# This file is OPTIONAL — the skeleton runs fine without it using the
# defaults baked into docker-compose.yml. Override only if you want to.

# Secret key signs Flask session cookies. Override this in production
# with a long random string.
# SECRET_KEY=dev-secret-not-for-production

# Database URL. Default points at the db service in Compose.
# DATABASE_URL=postgresql://app:app@db:5432/app

# Dungeon frontend folder served at /site/. Default is S3_content (assignment).
# Use S3_content_mvp for future MVP debugging.
# S3_CONTENT_DIR=S3_content_mvp

# GitHub OAuth credentials (Week 7). Create an OAuth App at
# https://github.com/settings/developers and paste the values here.
# OAUTH_CLIENT_ID=your-github-oauth-app-client-id
# OAUTH_CLIENT_SECRET=your-github-oauth-app-client-secret

# Enable server-side ShadowDarklings imports in production. Keep this off unless
# the deployed image includes Playwright Chromium and the route remains login-gated.
# SHADOWDARKLINGS_IMPORT_ENABLED=1

# SD Dungeon Generator — environment configuration
#
# Copy this file to .env (which is gitignored) and fill in your values:
#   cp .env.example .env
#
# REQUIRED: the app reads these with os.environ["KEY"] (CONTRACTS.md §12) and
# crashes on startup if any are missing. docker-compose.yml also requires the
# .env file to exist (env_file: required: true).

# Signs Flask session cookies. Use a long random string in production,
# e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# GitHub OAuth credentials (CONTRACTS.md §3b). Create an OAuth App at
# https://github.com/settings/developers and paste the values here.
OAUTH_CLIENT_ID=your-github-oauth-app-client-id
OAUTH_CLIENT_SECRET=your-github-oauth-app-client-secret

# Database URL. docker-compose.yml overrides this for the containerized stack
# (postgresql://app:app@db:5432/app); set it here for bare-metal local runs.
DATABASE_URL=postgresql://app:app@localhost:5432/app

# ── Optional, local development only ────────────────────────────────────────

# Lets the static frontend call the ShadowDarklings importer without logging
# in (CONTRACTS.md §2, AGENTS.md). NEVER set this in production.
# ALLOW_ANON_SHADOWDARKLINGS_IMPORT=1

# Force-enable/disable the importer regardless of FLASK_ENV
# (default: enabled unless FLASK_ENV=production).
# SHADOWDARKLINGS_IMPORT_ENABLED=1

# SD Dungeon Generator - environment configuration
#
# Copy this file to .env (which is gitignored) and fill in your values:
#   cp .env.example .env
#
# REQUIRED: the app reads these with os.environ["KEY"] (CONTRACTS.md section 12)
# and crashes on startup if any are missing. docker-compose.yml also requires the
# .env file to exist.

# Signs Flask session cookies. Use a long random string in production, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# GitHub OAuth credentials. Create an OAuth App at
# https://github.com/settings/developers and paste the values here.
OAUTH_CLIENT_ID=your-github-oauth-app-client-id
OAUTH_CLIENT_SECRET=your-github-oauth-app-client-secret

# Database URL. docker-compose.yml overrides this for the containerized stack
# (postgresql://app:app@db:5432/app); set it here for bare-metal local runs.
DATABASE_URL=postgresql://app:app@localhost:5432/app

# Local development convenience only. NEVER set this in production.
# ALLOW_ANON_SHADOWDARKLINGS_IMPORT=1

# Enable server-side ShadowDarklings imports in production. Keep this off unless
# the deployed image includes Playwright Chromium and the route remains login-gated.
# Default behavior: enabled unless FLASK_ENV=production.
# SHADOWDARKLINGS_IMPORT_ENABLED=1

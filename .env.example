# SD Dungeon Generator - environment configuration
#
# Copy this file to .env (which is gitignored) and fill in your values:
#   cp .env.example .env
#
# REQUIRED: the app reads these with os.environ["KEY"] (CONTRACTS.md section 12)
# and crashes on startup if any are missing. docker-compose.yml also requires the
# .env file to exist.

# Signs Flask session cookies. Use a long random string in production, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# GitHub OAuth credentials. Create an OAuth App at
# https://github.com/settings/developers and paste the values here.
OAUTH_CLIENT_ID=your-github-oauth-app-client-id
OAUTH_CLIENT_SECRET=your-github-oauth-app-client-secret

# Use distinct random URL-safe passwords for schema ownership and the web role.
# The web process receives only DATABASE_URL, never the owner password.
DB_OWNER_PASSWORD=replace-with-random-owner-password
DB_APP_PASSWORD=replace-with-random-app-password
DATABASE_URL=postgresql://sd_app:replace-with-random-app-password@db:5432/app
PUBLIC_BASE_URL=https://ctreeder.com
RATELIMIT_STORAGE_URI=redis://redis:6379/0

# Local development convenience only. NEVER set this in production.
# ALLOW_ANON_SHADOWDARKLINGS_IMPORT=1

# Enable server-side ShadowDarklings imports in production. Keep this off unless
# the deployed image includes current Chromium. Signed-in users and joined guests
# may import; concurrency is bounded across workers by Redis.
# Default behavior: enabled unless FLASK_ENV=production.
# SHADOWDARKLINGS_IMPORT_ENABLED=1

# Optional security tuning. Defaults are intentionally usable for normal saves
# and long passphrases while still bounding abuse.
# MAX_CONTENT_LENGTH_BYTES=5242880
# PASSWORD_MIN_LENGTH=6
# PASSWORD_MAX_LENGTH=1024
# Local-only preview: python scripts/dev_preview.py (isolated SQLite database).
